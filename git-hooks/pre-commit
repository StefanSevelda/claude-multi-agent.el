#!/bin/bash
# Pre-commit hook to run syntax validation tests
# Install: cp git-hooks/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit

# Check if any .el files are being committed
if git diff --cached --name-only | grep -q "\.el$"; then
    echo "Running parenthesis balance check for all .el files..."

    if ! python3 test/check-parens.py > /tmp/pre-commit-parens.log 2>&1; then
        echo ""
        echo "❌ Parenthesis balance check FAILED!"
        echo ""
        echo "Please fix the errors before committing:"
        cat /tmp/pre-commit-parens.log
        echo ""
        echo "To skip this check, use: git commit --no-verify"
        exit 1
    fi

    echo "✅ Parenthesis balance check passed!"

    # Check if autoload/claude-multi-status.el specifically is being committed
    if git diff --cached --name-only | grep -q "autoload/claude-multi-status.el"; then
        echo "Running detailed syntax validation tests for claude-multi-status.el..."

        if ! ./test/run-syntax-tests.sh > /tmp/pre-commit-test.log 2>&1; then
            echo ""
            echo "❌ Detailed syntax validation tests FAILED!"
            echo ""
            echo "Please fix the errors before committing:"
            cat /tmp/pre-commit-test.log
            echo ""
            echo "To skip this check, use: git commit --no-verify"
            exit 1
        fi

        echo "✅ Detailed syntax validation tests passed!"
    fi
fi

exit 0
