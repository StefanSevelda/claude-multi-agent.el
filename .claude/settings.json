{
  "permissions": {
    "allow": [
      "Bash",
      "Edit",
      "Write",
      "Read"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "emacs --batch -l test/run-tests.el 2>&1 | tail -50"
          }
        ]
      }
    ]
  }
}
