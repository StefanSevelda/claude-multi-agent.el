{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Edit(*)",
      "Write(*)",
      "Read(*)"
    ]
  },
  "hooks": {
    "afterToolUse": [
      {
        "description": "Run tests after editing Emacs Lisp files",
        "match": {
          "toolNames": ["Edit", "Write"],
          "filePatterns": ["**/*.el"]
        },
        "command": "emacs --batch -l test/run-tests.el 2>&1 | tail -50"
      }
    ]
  }
}
